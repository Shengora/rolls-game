  <script>
    // Анимация лоадера весит 2 МБ: пока грузится основной код приложения, она отнимала у него канал.
    // Файл запрашиваем после DOMContentLoaded — к нему модульные скрипты Nuxt уже загружены и исполнены.
    (function () {
      // новая картинка, а не смена src: сменённая не показывалась по частям и до ухода лоадера не успевала,
      // а новая, как и раньше, начинает играть с первых пришедших кадров
      function startLoaderAnimation() {
        var slot = document.getElementById('app-loader-animation');
        if (!slot) return;
        var loader = document.createElement('img');
        loader.setAttribute('fetchpriority', 'low');
        loader.alt = 'loader';
        loader.style.cssText = 'width: 96px; height: 96px; object-fit: contain;';
        loader.src = '/assets/loader.webp';
        slot.replaceWith(loader);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startLoaderAnimation, { once: true });
      } else {
        startLoaderAnimation();
      }
    })();
  </script>

  <script>
    (function () {
      const TAPPS_URL = 'https://t.me/tapps/center?startapp=loyalty-rolls';

      function initTappsBanner() {
        const banner = document.getElementById('tapps-promotion');
        if (!banner) return;

        banner.style.cursor = 'pointer';
        banner.addEventListener('click', function () {
          try {
            if (window.Telegram && window.Telegram.WebApp && typeof window.Telegram.WebApp.openTelegramLink === 'function') {
              window.Telegram.WebApp.openTelegramLink(TAPPS_URL);
              return;
            }
            if (window.Telegram && window.Telegram.WebApp && typeof window.Telegram.WebApp.openLink === 'function') {
              window.Telegram.WebApp.openLink(TAPPS_URL);
              return;
            }
          } catch (e) { }
          window.location.href = TAPPS_URL;
        }, { passive: true });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTappsBanner, { once: true });
      } else {
        initTappsBanner();
      }
    })();
  </script>
