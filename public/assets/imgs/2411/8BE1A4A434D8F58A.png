<script type="module" src="/_nuxt/ZEhFy-gV.js" crossorigin></script></head><body><div id="__nuxt"><head>
  <style>
    html {
      background: #101115;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    html,
    body,
    #__nuxt,
    .container {
      padding: 0;
      margin: 0;
      height: 100%;
      font-family: 'Inter', sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    .loading-container {
      background: var(--loader-background, #101115);
      --top-safe: calc(var(--tg-safe-area-inset-top, 0px) + var(--tg-content-safe-area-inset-top, 0px));
      --bottom-safe: var(--tg-safe-area-inset-bottom, 0px);
      --app-navigation-height: 0px;
      --app-navigation-height-safe: calc(var(--app-navigation-height) + var(--bottom-safe));
      --app-padding-bottom: var(--app-navigation-height-safe);
      --app-height-safe: var(--tg-viewport-height, 100vh);
    }

    .container {
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      grid-template-columns: 1fr;
      justify-content: center;
      height: 100%;
    }

    .inner {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin: 0 auto;
    }

    .inner .arrow {
      position: absolute;
      top: -5px;
      left: 0;
      right: 0;
      margin: auto;
      z-index: 1;
    }

    .inner .circle {
      animation: spin 4s linear infinite;
    }

    .promotions-list {
      display: flex;
      flex-direction: column;
      justify-content: end;
      padding-left: 16px;
      padding-right: 16px;
      /* низ баннера — 74 px над нижним отступом, как в макете 8780:613566 */
      padding-bottom: calc(74px + var(--app-padding-bottom));
      width: 100%;
      min-width: 0;
      overflow: hidden;
    }

    .promotion {
      display: flex;
      align-items: end;
      gap: 11px;
      justify-content: start;
      width: 100%;
      min-width: 0;
      opacity: 0;
      transform: translate(-32px, 32px);
      animation: promotion-slide-in 700ms cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
      will-change: transform, opacity;
    }

    .promotion .circle {
      width: 37px;
      height: 37px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #25272E;
      border-radius: 100%;
      position: relative;
    }

    .promotion .message {
      position: relative;
      display: flex;
      height: 80px;
      padding: 8px 16px 16px 16px;
      flex-direction: column;
      justify-content: space-between;
      align-items: start;
      gap: 4px;
      border-radius: 16px;
      background: #25272E;
      margin-bottom: 9px;
      font-feature-settings: 'liga' off, 'clig' off;
      flex: 1;
      justify-content: center;
    }

    /* 
    .promotion .message.message-staking {
      padding-top: 16px;
      padding-bottom: 16px;
      height: 113px;
      gap: 2px;
    } */

    .promotion .message.message-staking .text-wrapper {
      gap: 8px;
      width: 100%;
    }

    .promotion .message.message-staking .animations {
      justify-content: space-between;
      /* width: 100%; */
    }

    .promotion .message .message-inner {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .promotion .message .vector {
      position: absolute;
      left: -7px;
      bottom: -8px;
    }

    .promotion .message .top {
      color: #8A92A8;
      font-size: 13px;
      font-weight: 700;
      line-height: 150%;
      letter-spacing: -0.26px;
    }

    .promotion .message .text-wrapper {
      display: flex;
      gap: 4px;
      align-items: start;
    }

    .promotion .message .text-wrapper img {
      object-fit: contain;
    }

    .promotion .message .text-wrapper .text {
      color: #FFF;
      font-feature-settings: 'liga' off, 'clig' off;
      font-size: 15px;
      font-weight: 700;
      line-height: 150%;
      letter-spacing: -0.3px;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .promotion .message .text-wrapper .animations {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .promotion .message-lucky {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .lucky-image-wrapper {
      object-fit: contain;
      height: 72px;
      width: 72px;
      max-width: 72px;
      max-height: 72px;
      aspect-ratio: 170/166;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lucky-image {
      width: 170px;
      height: 166px;
      min-width: 170px;
      min-height: 166px;
    }

    #app-center-logo {
      width: 36px;
      height: 36px;
      flex: none;
      object-fit: contain;
      border-radius: 100%;
    }

    #tapps-promotion {
      cursor: pointer;
    }

    @keyframes spin {
      from {
        transform: rotate(0deg);
      }

      to {
        transform: rotate(360deg);
      }
    }

    @keyframes promotion-slide-in {
      from {
        opacity: 0;
        transform: translate(-32px, 32px);
      }

      to {
        opacity: 1;
        transform: translate(0, 0);
      }
    }
    /* Баннер Cases (8780:613868): белый 6 %, рамка 2 %, радиус 20, арт справа 182×80 */
    .promotion.promotion-cases {
      gap: 9px;
    }

    .promotion-cases .avatar {
      width: 40px;
      height: 40px;
      flex: none;
      margin-bottom: 1px;
      border-radius: 100%;
    }

    .promotion .message.message-cases {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0;
      height: 80px;
      padding: 0 0 0 20px;
      margin-bottom: 0;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.06);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
      overflow: hidden;
    }

    .message-cases .copy {
      display: flex;
      flex-direction: column;
      gap: 4px;
      white-space: nowrap;
      font-weight: 700;
    }

    .message-cases .copy .top {
      color: rgba(255, 255, 255, 0.5);
    }

    .message-cases .copy .title {
      color: #FFF;
      font-size: 16px;
      line-height: 1.2;
      letter-spacing: -0.32px;
    }

    .message-cases .art {
      width: 182px;
      height: 80px;
      flex: none;
      object-fit: cover;
    }
  </style>
  <script>
    // Фон — тот, что пользователь выбрал для PvP (ROLLS-015). Приложение кладёт выбор в ключ устройства
    // (APP_LOADER_BACKGROUND_STORAGE_KEY в domain/app.ts), цвета — как в assets/css/main.css. Читаем до
    // первой отрисовки; нет выбора — голубой, как в PvP по умолчанию.
    (function () {
      var backgrounds = {
        'pvp-purple': 'radial-gradient(50% 50% at 50% 50%, #420188 0%, #2B0157 50%, #1F003F 75%, #130026 100%), #130026',
        'pvp-blue': 'radial-gradient(50% 50% at 50% 50%, #1533C4 0%, #0B1A7C 50%, #060D58 75%, #010034 100%), #010034',
        'pvp-teal': 'radial-gradient(50% 50% at 50% 50%, #007580 0%, #00474E 50%, #003034 75%, #00191B 100%), #00191B',
        'pvp-red': 'radial-gradient(50% 50% at 50% 50%, #930000 0%, #590000 50%, #3C0000 75%, #1F0000 100%), #1F0000',
        'pvp-green': 'radial-gradient(50% 50% at 50% 50%, #07602C 0%, #053A1B 50%, #032612 75%, #021309 100%), #021309',
        'pvp-magenta': 'radial-gradient(50% 50% at 50% 50%, #BD0181 0%, #73014E 50%, #4D0035 75%, #28001B 100%), #28001B',
        'dark': 'radial-gradient(56% 56% at 50% 44%, #1F2026 0%, #121316 50%, #050505 100%), #050505',
        'pvp-sky': 'radial-gradient(50% 50% at 50% 50%, #0775C9 0%, #050F30 100%), #050F30',
      };
      var saved;
      try {
        saved = localStorage.getItem('rolls:loader-background-v2');
      } catch (e) { }
      // переменная, а не фон корня: корень остаётся приложению, а стартовый экран уходит вместе с разметкой
      document.documentElement.style.setProperty('--loader-background', backgrounds[saved] || backgrounds['pvp-sky']);
    })();
  </script>
